# Package identity used by render-manifests.sh. Values marked TODO(confirm) are
# placeholders the project owner must confirm before publishing anywhere.

# TODO(confirm): maintainer shown in the AUR PKGBUILDs (AUR style obfuscates the email).
MAINTAINER="Michael Christenson II <m3talsmith at gmail dot com>"
# Publisher name and URL shown by winget.
PUBLISHER="WeirdBrains"
PUBLISHER_URL="https://github.com/WeirdBrains"
# winget PackageIdentifier (Publisher.Package). Must be unique in winget-pkgs; it also
# sets the manifest path, manifests/w/WeirdBrains/grokbot-tui/<version>/.
WINGET_ID="WeirdBrains.grokbot-tui"
